{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-notifications",
  "description": "Allow the local main window to check/request notification permission and send a notification.",
  "windows": ["main"],
  "permissions": [
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
