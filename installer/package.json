{
  "name": "@kipster/installer",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "macOS installer and recoverable updater for Kipster Core",
  "type": "module",
  "engines": { "node": ">=26.10.0 <27" },
  "files": ["src", "launchers", "README.md"],
  "bin": { "kipster": "./src/cli.mjs" },
  "scripts": {
    "build": "node --check src/cli.mjs",
    "build:macos": "node native/build.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:postgres": "node tests/with-postgres.mjs",
    "test:e2e:macos": "node --test tests/e2e.mjs",
    "prepack": "npm run build"
  }
}
